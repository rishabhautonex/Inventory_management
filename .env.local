# Supabase -> Connect -> ORMs -> Drizzle.
# Use the *session* pooler (port 5432) for migrations and the transaction
# pooler (port 6543) for the app. Either works for local development.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.tcmngdzozxgqpmjzxicp:Bapuaai%401234@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Only Google accounts on this domain may sign in. Comma-separate for several.
ALLOWED_EMAIL_DOMAINS="autonexai360.com"

# The very first user to sign in with this address is promoted to `manager`
# automatically, so there is somebody who can assign every other role.
BOOTSTRAP_MANAGER_EMAIL="rishabh.karpe@autonexai360.com"

# DeepSeek -> https://platform.deepseek.com/api_keys
# Optional. When set, an uploaded invoice is read twice — once by the built-in
# parser and once by DeepSeek — and the two readings are reconciled, so a
# quantity both agree on is trusted and one they differ on is left blank. The
# platform is prepaid; an empty account degrades to the parser alone.
# Server-only: the key never reaches the browser.
DEEPSEEK_API_KEY=<deepseek api key>
DEEPSEEK_MODEL=deepseek-v4-pro

# Shared secret for the scheduled jobs (/api/jobs/overdue, /api/jobs/digest).
# Vercel Cron sends it as Authorization: Bearer <value> automatically. Absent
# means both routes refuse every caller rather than running unauthenticated.
CRON_SECRET=